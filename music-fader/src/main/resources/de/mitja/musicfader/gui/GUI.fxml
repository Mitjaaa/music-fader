<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="150.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/10.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mitja.musicfader.gui.GUIController">
   <children>
      <Button fx:id="fadeInBtn" layoutX="54.0" layoutY="84.0" mnemonicParsing="false" onMouseClicked="#onFadeInClicked" prefHeight="35.0" prefWidth="63.0" text="Fade in" textFill="#45bf49" />
      <Button fx:id="fadeOutBtn" layoutX="184.0" layoutY="84.0" mnemonicParsing="false" onMouseClicked="#onFadeOutClicked" prefHeight="35.0" prefWidth="63.0" text="Fade out" textFill="#d34545" />
      <ChoiceBox fx:id="iniSelector" layoutX="75.0" layoutY="33.0" prefWidth="150.0" />
      <Label layoutX="75.0" layoutY="14.0" text="Choose an ini-file:" />
      <Label fx:id="errorLabel" layoutX="85.0" layoutY="126.0" text="WAV-File does not exist!" textFill="#cd0c0c" visible="false" />
   </children>
</AnchorPane>
